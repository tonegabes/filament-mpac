includes:
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - vendor/calebdw/larastan-livewire/extension.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    parallel:
        maximumNumberOfProcesses: 1

    paths:
        - app
        - bootstrap
        - config
        - database
        - resources/views
        - public
        - routes
        - tests

    level: 8

    ignoreErrors:
        -
            message: '#Access to constant on internal class Laravel\\Pulse\\Recorders\\.#'
            path: config/pulse.php
        -
            message: '#Call to static method defaultVendorCacheKeys\(\) of internal class Laravel\\Pulse\\Pulse#'
            path: config/pulse.php

    excludePaths:
      - _ide_helper*.php
      - bootstrap/cache


#        - ./*/*/FileToBeExcluded.php
#
#    checkMissingIterableValueType: false

    tmpDir: /tmp/phpstan
