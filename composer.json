{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "tonegabes/filament-mpac",
  "type": "project",
  "description": "The skeleton application for the MPs",
  "keywords": [
    "laravel",
    "framework",
    "mpac",
    "filament",
    "tonegabes"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "al-saloul/filament-image-gallery": "^3.0",
    "codeat3/blade-phosphor-icons": "^2.3",
    "directorytree/ldaprecord-laravel": "^4.0.4",
    "filament/filament": "~5.0",
    "filament/spatie-laravel-media-library-plugin": "~5.0",
    "filament/spatie-laravel-settings-plugin": "~5.0",
    "janczakb/filament-flex-fields": "^2.7",
    "laravel/framework": "^13.0",
    "laravel/pulse": "^1.7",
    "laravel/tinker": "^3.0",
    "opcodesio/log-viewer": "^3.19",
    "spatie/laravel-activitylog": "^5.0",
    "spatie/laravel-pdf": "^2.1",
    "spatie/laravel-permission": "^8.3",
    "tonegabes/filament-better-options": "^1.3",
    "tonegabes/filament-phosphor-icons": "^1.3",
    "tonegabes/mpac-essentials": "^1.1"
  },
  "require-dev": {
    "calebdw/larastan-livewire": "^2.5",
    "fakerphp/faker": "^1.24.1",
    "friendsofphp/php-cs-fixer": "^3.88.2",
    "larastan/larastan": "^3.7.2",
    "laravel/boost": "^2.0",
    "laravel/pail": "^1.2.3",
    "laravel/pint": "^1.30",
    "laravel/sail": "^1.46",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.8.2",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-faker": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "phpstan/phpstan-deprecation-rules": "^2.0.3",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^13.0",
    "tonegabes/laravel-make-model-plus": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": [
      "pint --test --no-interaction --ansi --config=vendor/tonegabes/mpac-essentials/pint.json"
    ],
    "format": [
      "pint --no-interaction --ansi --config=vendor/tonegabes/mpac-essentials/pint.json"
    ],
    "lint:dirty": [
      "pint --test --dirty --no-interaction --ansi --config=vendor/tonegabes/mpac-essentials/pint.json"
    ],
    "format:dirty": [
      "pint --dirty --no-interaction --ansi --config=vendor/tonegabes/mpac-essentials/pint.json"
    ],
    "analyze": [
      "phpstan analyze --memory-limit=4G --no-progress --no-interaction --ansi"
    ],
    "pre-autoload-dump": [
      "@php -r \"file_exists('bootstrap/cache/packages.php') && unlink('bootstrap/cache/packages.php');\"",
      "@php -r \"file_exists('bootstrap/cache/services.php') && unlink('bootstrap/cache/services.php');\""
    ],
    "post-autoload-dump": [
      "@php artisan config:clear",
      "@php artisan clear-compiled",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "update:requirements": [
      "composer bump",
      "npx npm-check-updates -u"
    ],
    "fresh:db": [
      "@php artisan migrate:fresh --seed"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "test": [
      "@php artisan config:clear --ansi",
      "@php artisan test"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
